# ============================================================
# Academic Materials Collection Assistant – Environment Config
# Copy this file to .env and fill in your API keys.
# ============================================================

# ---- LLM Provider ----
# "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- Academic Database API Keys ----

# Web of Science (Clarivate): https://developer.clarivate.com/
WOS_API_KEY=

# IEEE Xplore: https://developer.ieee.org/
IEEE_API_KEY=

# ---- General Web Search ----

# Serper (Google Search): https://serper.dev/
SERPER_API_KEY=

# Brave Search: https://api.search.brave.com/
BRAVE_API_KEY=

# ---- CNKI (中国知网) ----
# Optional session cookie for improved CNKI access (log in and copy cookie from browser)
CNKI_SESSION_COOKIE=
# Optional proxy for CNKI requests
CNKI_PROXY=

# ---- Search Defaults ----
DEFAULT_MAX_RESULTS=10

# ---- MCP Server ----
# Transport type: "stdio" (for Claude Desktop) or "sse" (HTTP server mode)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
